          "specification": {
            "benchmark_functions": {
              "sphere": {
                "formula": "sum(x_i^2)",
                "dim": 5,
                "bounds": [
                  -5.12,
                  5.12
                ],
                "global_minimum": 0
              },
              "rastrigin": {
                "formula": "10n + sum(x_i^2 - 10*cos(2*pi*x_i))",
                "dim": 5,
                "bounds": [
                  -5.12,
                  5.12
                ],
                "global_minimum": 0
              },
              "ackley": {
                "formula": "Ackley 2D: x = np.asarray(x); return -20*np.exp(-0.2*np.sqrt(0.5*np.sum(x**2))) - np.exp(0.5*np.sum(np.cos(2*np.pi*x))) + 20 + np.e",
                "dim": 2,
                "bounds": [
                  -5,
                  5
                ],
                "global_minimum": 0
              },
              "rosenbrock": {
                "formula": "sum(100*(x_{i+1}-x_i^2)^2 + (1-x_i)^2)",
                "dim": 5,
                "bounds": [
                  -2,
                  2
                ],
                "global_minimum": 0
              },
              "griewank": {
                "formula": "x = np.asarray(x).flatten(); return 1 + np.sum(x**2 / 4000) - np.prod(np.cos(x / np.sqrt(np.arange(1, len(x) + 1))))",
                "dim": 5,
                "bounds": [
                  -600,
                  600
                ],
                "global_minimum": 0
              }
            },
            "required_functions": [
              "sphere",
              "rastrigin",
              "ackley",
              "rosenbrock",
              "griewank"
            ],
            "dispatch": {
              "lookup": "Use benchmark_functions[name] dim and bounds. bounds is [low, high] repeated dim times as Real(low, high). Never use func.__code__.co_argcount.",
              "random_search": "random_search(func, dim, bounds, n_iterations=50, seed=seed)",
              "bayesian_optimization": "bayesian_optimization(func, dim, bounds, n_calls=50, n_initial_points=10, seed=seed)",
              "rule": "Branch on --optimizer. Never pass n_calls into random_search."
            },
            "random_search": {
              "implementation": "np.random.uniform per dimension using that function's dim and bounds",
              "n_iterations": 50
            },
            "bayesian_optimization": {
              "required_import": "from skopt import gp_minimize",
              "required_call": "gp_minimize(func, [Real(lo, hi)] * dim, n_calls=50, n_initial_points=10, random_state=seed)",
