# Ollama Configuration
OLLAMA_HOST=http://localhost:11434

# Model Configuration (defaults for 16GB unified memory)
ANALYST_MODEL=qwen3.5:9b
PLANNER_MODEL=qwen3.5:9b
ENGINEER_MODEL=qwen2.5-coder:7b
REVIEWER_MODEL=qwen3.5:9b
REASONING_FALLBACK_MODEL=gpt-oss:20b

# LLM Generation Settings
MODEL_TEMPERATURE=0.1
MODEL_NUM_PREDICT=2048
PLANNER_NUM_PREDICT=4096
# Review Tolerances
REVIEW_MATCH_TOLERANCE_PCT=2.0
REVIEW_CLOSE_TOLERANCE_PCT=20.0

# Execution Settings
MAX_RETRY_ATTEMPTS=5
ENGINEER_MAX_ATTEMPTS=3
EXECUTOR_TIMEOUT_SECONDS=600
EXECUTOR_LOG_MAX_CHARS=5000
MIN_FREE_MEMORY_GB=2.0
# Default: run plan matrix rows only. Set to 1 for full axes cartesian expansion.
ENGINEER_EXPAND_FULL_AXES=0
# Optional: Docker Desktop on macOS (auto-detected if unset)
# DOCKER_HOST=unix:///Users/YOU/.docker/run/docker.sock
# Paper repo venv name inside the mounted Docker workspace
# PAPER_VENV_DIRNAME=.venv

# Paper Ingestion Settings
INGEST_CLONE_TIMEOUT_SECONDS=300

# PostgreSQL Database (REQUIRED)
# Create a PostgreSQL database and set the connection string:
# Example: postgresql://username:password@localhost/research_assistant
POSTGRES_DSN=postgresql://localhost/research_assistant